  "final_failure": {
    "when": "valid_submissions == 4 and none accepted",
    "ui": "existing answer reveal, no earned success or XP",
    "scene_assets_changed": false,
    "blocked_until_grading_approved": false
  },
  "hint_1": {
    "ui": "existing hint popup with selected character profile",
    "button": "다음 힌트 보기",
    "attempt_delta": 0,
    "scene": "selected_character_scene"
  },
  "hint_2": {
    "ui": "existing hint popup with selected character profile",
    "button": "close",
    "attempt_delta": 0,
    "scene": "selected_character_scene"
  },
  "explanation": {
    "ui": "reuse application explanation UI",
    "source": "content/explanation.json",
    "scene_assets_changed": false,
    "content_status": "APPROVED"
  },
  "completion": {
    "next": "rewards screen only when learning flow completed, reward determined by existing reward system",
