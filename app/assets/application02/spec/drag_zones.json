  "art_quality_gate": "NOT_FOR_PRODUCTION_UNTIL_APPROVED",
  "attempt_policy": {
    "scope": "entire_application_problem_across_both_stages",
    "total_valid_wrong_drop_limit": 4,
    "initial_attempts": 1,
    "max_retries": 3,
    "increment_on": [
      "step1_wrong",
      "step2_wrong"
    ],
    "do_not_increment_on": [
      "correct_drop",
      "invalid_drop",
      "cancel",
      "pointer_move"
    ],
    "on_fourth_valid_wrong": {
      "transition_to": "answer_reveal",
      "direct_success": false,
      "awards_xp": false,
      "show_correct_route": true
    },
    "step1_success_is_intermediate": true,
    "can_award_xp_after_step1": false
  },
  "temporal_safety_guards": {
    "stage2_requires_all": [
      "train_stopped",
      "doors_fully_open",
      "exiting_complete",
      "reboarding_safe"
    ],
    "door_closing_blocks_stage2": true,
    "train_moving_blocks_stage2": true,
    "passengers_exiting_blocks_stage2": true,
    "exiting_complete": "after runtime passenger_animation finished at 1750ms and all exiting entities have moved out"
  },
  "footprint_adjustments_v5": "for station and cabin, verify actual alpha silhouette / occupied lower-body region against retain passenger masks and tactile strip; superseded for runtime drop acceptance by drop_acceptance_v6, still used for landing QA",
  "drop_acceptance_v6": {
    "style": "correct-intent foot-anchor point + canonical-position snap",
    "gesture": "grab on visible hero alpha or expanded touch target; convert pointer and drag-start offset to scene coordinates, preserving initial pointer-to-visual-foot displacement; recompute release visual foot anchor, not raw finger point; clamp sprite to scene during drag, treat out-of-scene as invalid.",
    "drop_foot_anchor_formula": "release_scene_foot_anchor = scene_pointer_release - pointer_offset_at_drag_start (in scene coordinate units). For touch proxy use the dragged sprite mapped visual foot anchor.",
    "classification_order": [
      "blocked_stage2_flag=>disabled_no_count",
      "outside_scene_or_explicit_invalid_structure=>invalid_no_count",
      "explicit_wrong_hazard=>wrong_valid",
      "correct_foot_anchor_intent=>correct_snap",
      "other_unclassified_background=>invalid_no_count"
    ],
    "target_zone_kind": "GESTURE_ACCEPTANCE_AREA_NOT_A_PLACE_TO_LEAVE_THE_SPRITE",
