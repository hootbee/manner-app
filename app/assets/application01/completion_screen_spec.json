{
  "schema_version": "1.0",
  "id": "completion_reward_common",
  "runtime_style": "approved monochrome MANNERS completion screens",
  "title_is_independent_result_page": true,
  "not_a_problem_screen": true,
  "header": {
    "back_button": true,
    "notification_button": true,
    "logo": false,
    "progress_bar": false,
    "alignment": "back-left and notification-right, maintain safe area"
  },
  "assets": {
    "characters": {
      "dangdang": "runtime/completion/characters/dangdang_celebrate_rgba.png",
      "nyangnyang": "runtime/completion/characters/nyangnyang_celebrate_rgba.png",
      "mongmong": "runtime/completion/characters/mongmong_celebrate_rgba.png"
    },
    "small_character_profiles": {
      "dangdang": "runtime/explanation/profiles/dangdang_profile_rgba_256.png",
      "nyangnyang": "runtime/explanation/profiles/nyangnyang_profile_rgba_256.png",
      "mongmong": "runtime/explanation/profiles/mongmong_profile_rgba_256.png"
    },
    "xp_reward_icon": "runtime/completion/xp_reward_medal_rgba.png",
    "confetti_decor": {
      "confetti_gold": "runtime/completion/decor/confetti_gold.png",
      "confetti_gray": "runtime/completion/decor/confetti_gray.png",
      "sparkle_gold": "runtime/completion/decor/sparkle_gold.png",
      "ribbon_gold": "runtime/completion/decor/ribbon_gold.png",
      "ribbon_gray": "runtime/completion/decor/ribbon_gray.png",
      "burst_gold": "runtime/completion/decor/burst_gold.png"
    },
    "celebration_source": "shared approved popup character PNG; separate character layers extracted without changing design"
  },
  "reference_previews": {
    "FIRST_DIRECT": "previews/completion_first_direct_approved.png",
    "FIRST_ANSWER_REVEAL": "previews/completion_first_reveal_approved.png",
    "REVIEW": "previews/completion_review_approved.png"
  },
  "common_widget_hierarchy": [
    "SafeArea",
    "CompletionTopBar(back,notification)",
    "TitleAndSubtitle",
    "CelebrationCharacterAndConfetti",
    "OptionalSmallCharacterSpeech",
    "RewardCard(icon + dynamic XP number)",
    "LevelProgressCard(dynamic profile data)",
    "LearnedMannerSummaryCard",
    "PrimaryBottomButton"
  ],
  "states": {
    "FIRST_DIRECT": {
      "title": "학습 완료!",
      "subtitle": "오늘도 멋진 매너를 하나 배웠어요!",
      "speech_bubble": null,
      "xp_key": "FIRST_DIRECT",
      "sample_only_xp": 20,
      "sample_only_progress": "80 / 100 XP",
      "label_learned_manner": "이번에 배운 매너",
      "trigger_when": "first topic completion AND both basic and application solved directly"
    },
    "FIRST_ANSWER_REVEAL": {
      "title": "학습 완료!",
      "subtitle": "정답을 확인하며 끝까지 매너를 익혔어요!",
      "speech_bubble": "끝까지 해냈어요! 정답을 확인하며 다시 배워봤어요.",
      "xp_key": "FIRST_ANSWER_REVEAL",
      "sample_only_xp": 10,
      "sample_only_progress": "70 / 100 XP",
      "label_learned_manner": "이번에 배운 매너",
      "trigger_when": "first topic completion AND basic OR application used fourth-attempt answer reveal"
    },
    "REVIEW": {
      "title": "복습 완료!",
      "subtitle": "익힌 매너를 다시 한번 점검했어요!",
      "speech_bubble": "다시 복습했어요! 익힌 매너를 한번 더 확인했네요.",
      "xp_key": "REVIEW",
      "sample_only_xp": 0,
      "sample_only_progress": "60 / 100 XP",
      "label_learned_manner": "이번에 배운 매너",
      "trigger_when": "topic has been completed before; reward event already exists"
    }
  },
  "rewards": "spec/reward_config.json",
  "dynamic_data_fields": [
    "selectedCharacterId",
    "topicTitle",
    "xpAwarded",
    "currentLevel",
    "currentXP",
    "previousLevelProgress",
    "currentLevelProgress",
    "xpToNextLevel",
    "levelProgressMax",
    "isLevelUp"
  ],
  "render_rules": {
    "never_embed_xp_level_or_progress_numbers_in_assets": true,
    "title_and_copy_as_flutter_text": true,
    "xp_display": "+{xpAwarded} XP",
    "reward_card_title": "획득한 보상",
    "level_display": "Lv. {currentLevel}",
    "current_xp_display": "현재 경험치 {currentXP} XP",
    "xp_until_next_display": "다음 레벨까지 {xpToNextLevel} XP 남았어요!",
    "progress_fraction": "clamp(currentLevelProgress/levelProgressMax,0,1)",
    "progress_label": "{currentLevelProgress} / {levelProgressMax} XP",
    "progress_on_level_up": "animate remaining previous-level progress → level reset → new-level progress; only when user data indicates threshold crossed",
    "learned_card_title": "이번에 배운 매너",
    "learned_card_text": "지하철에서 다른 승객을 배려하며 짐 관리하기",
    "not_hardcode_preview_80_70_60": true
  },
  "responsive_dp": {
    "base_design_width": 360,
    "mobile_content_horizontal_padding": 16,
    "content_max_width": 440,
    "title_sp": 32,
    "subtitle_sp": 14,
    "body_sp": 14,
    "button_sp": 16,
    "button_height": 48,
    "container_card_radius": 16,
    "card_padding_horizontal": 16,
    "card_padding_vertical": 14,
    "card_gap": 12,
    "reward_medal_height": 64,
    "hero_height_mobile_range": [
      152,
      192
    ],
    "hero_fit": "contain",
    "small_profile_diameter": 52,
    "speech_bubble_padding": 12,
    "progress_track_height": 10,
    "top_bar_height": 56,
    "safe_area": true,
    "bottom_button_safe_inset": 16,
    "for_height_less_than_700dp": "single scrollable column; reduce vertical gaps and mascot height first; keep 48dp CTA tap target",
    "for_width_600dp_and_above": "center content to max 440dp and increase outer margins; do not scale body text to billboard sizes",
    "text_scale_policy": "respect system textScaleFactor; do not force fixed card height",
    "bottom_cta": "one button only, may use pinned SafeArea footer with ScrollView for main content"
  },
  "colors": {
    "background": "#FFFFFF",
    "text": "#1B1E1B",
    "secondary": "#737D8C",
    "card": "#F7F8FA",
    "card_border": "#E5E9EF",
    "button": "#1B1E1B",
    "button_text": "#FFFFFF",
    "xp_gold": "#D99A28",
    "progress_track": "#E5E5E5",
    "progress_fill": "#666666",
    "confetti_gold": "#ECB241",
    "confetti_gray": "#B7BABC"
  },
  "button": {
    "label": "다음 문제로 이동",
    "route": "/learning/transit/02/basic",
    "on_tap": "navigate_after_reward_commit_and_screen_state_stable",
    "number_of_buttons": 1
  },
  "navigation": [
    "transit_01_basic",
    "transit_01_basic_explanation",
    "transit_01_application",
    "transit_01_application_explanation",
    "transit_01_completion_reward",
    "transit_02_basic"
  ],
  "entering_completion_screen_again": "Recompute display from saved state; never grant award again",
  "reduces_motion": "See spec/completion_animation_spec.json"
}
